# Google Sheets sink (all three required; the API returns 500 without them)
GOOGLE_SERVICE_ACCOUNT_EMAIL=lead-writer@your-project.iam.gserviceaccount.com
# Paste the key from the JSON file. Literal \n sequences are fine.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SHEET_ID=your-spreadsheet-id
# Optional, defaults to Leads
SHEET_TAB=Leads

# Optional: Cloudflare Turnstile. Set both this and TURNSTILE_SITE_KEY in js/config.js to enable.
TURNSTILE_SECRET_KEY=
