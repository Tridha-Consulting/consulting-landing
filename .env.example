# Google Sheets sink (all three required; the API returns 500 without them)
GOOGLE_SERVICE_ACCOUNT_EMAIL=lead-writer@your-project.iam.gserviceaccount.com
# Paste the key from the JSON file. Literal \n sequences are fine.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SHEET_ID=your-spreadsheet-id
# Optional, defaults to Leads
SHEET_TAB=Leads

# Optional: Cloudflare Turnstile. Set both this and TURNSTILE_SITE_KEY in js/config.js to enable.
TURNSTILE_SECRET_KEY=

# Cal.com webhook signing secret (same value as the Secret field on the Cal.com webhook). /api/cal-webhook returns 500 without it.
CAL_WEBHOOK_SECRET=

# Google Calendar declines. CALENDAR_ID and CALENDAR_CHANNEL_TOKEN are needed by both /api/calendar-notify and /api/calendar-cron;
# CRON_SECRET only by /api/calendar-cron. Unset, the endpoint answers 500; the rest of the site works without them.
# The calendar Cal.com books onto; share it with the service account above with "See all event details".
CALENDAR_ID=consulting@example.com
# Any long random string. Google echoes it in X-Goog-Channel-Token on every push notification (wrong or missing: 401).
CALENDAR_CHANNEL_TOKEN=change-me-long-random-string
# Any long random string. Vercel sends it as a Bearer token to the daily cron, which answers 401 for a wrong or missing one.
CRON_SECRET=change-me-another-long-random-string
